+package com.oney.WebRTCModule.webrtcutils;
+
+import android.util.Log;
+
+import org.webrtc.VideoCodecStatus;
+import org.webrtc.VideoEncoder;
+import org.webrtc.VideoFrame;
+
+/**
+ * Wraps a Java video encoder (the hardware H.264 one) so a Java exception thrown inside it is
+ * turned into an error status instead of reaching libwebrtc's JNI layer. There an uncaught
+ * exception is a CHECK failure (jvm.cc "Check failed: false") that aborts the whole app — e.g.
+ * HardwareVideoEncoder.initEncode throwing GLException "Failed to create EGL context" when the
+ * process has run out of EGL contexts. With this the stream just stops encoding and the app's
+ * own watchdog restarts it.
+ */
+public class SafeVideoEncoder implements VideoEncoder {
+    private static final String TAG = "SafeVideoEncoder";
+    private final VideoEncoder inner;
+
+    public SafeVideoEncoder(VideoEncoder inner) {
+        this.inner = inner;
+    }
+
+    @Override
+    public boolean isHardwareEncoder() {
+        return inner.isHardwareEncoder();
+    }
+
+    @Override
+    public VideoCodecStatus initEncode(Settings settings, Callback callback) {
+        try {
+            return inner.initEncode(settings, callback);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "initEncode failed (" + settings.width + "x" + settings.height + "), not aborting", e);
+            try { inner.release(); } catch (RuntimeException ignored) { /* half-initialised */ }
+            return VideoCodecStatus.ERROR;
+        }
+    }
+
+    @Override
+    public VideoCodecStatus release() {
+        try {
+            return inner.release();
+        } catch (RuntimeException e) {
+            Log.e(TAG, "release failed", e);
+            return VideoCodecStatus.ERROR;
+        }
+    }
+
+    @Override
+    public VideoCodecStatus encode(VideoFrame frame, EncodeInfo info) {
+        try {
+            return inner.encode(frame, info);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "encode failed", e);
+            return VideoCodecStatus.ERROR;
+        }
+    }
+
+    @Override
+    public VideoCodecStatus setRateAllocation(BitrateAllocation allocation, int framerate) {
+        try {
+            return inner.setRateAllocation(allocation, framerate);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "setRateAllocation failed", e);
+            return VideoCodecStatus.ERROR;
+        }
+    }
+
+    @Override
+    public VideoCodecStatus setRates(RateControlParameters parameters) {
+        try {
+            return inner.setRates(parameters);
+        } catch (RuntimeException e) {
+            Log.e(TAG, "setRates failed", e);
+            return VideoCodecStatus.ERROR;
+        }
+    }
+
+    @Override
+    public ScalingSettings getScalingSettings() {
+        return inner.getScalingSettings();
+    }
+
+    @Override
+    public ResolutionBitrateLimits[] getResolutionBitrateLimits() {
+        return inner.getResolutionBitrateLimits();
+    }
+
+    @Override
+    public String getImplementationName() {
+        return inner.getImplementationName();
+    }
+
+    @Override
+    public EncoderInfo getEncoderInfo() {
+        return inner.getEncoderInfo();
+    }
+}
