@@ -0,0 +1,40 @@
+package com.oney.WebRTCModule;
+
+import org.webrtc.CapturerObserver;
+import org.webrtc.VideoFrame;
+
+/**
+ * Adds the controller's extra rotation to every captured frame. WebRTC already turns each frame to
+ * match the screen; this turns it further, so the stream can face any way without rotating the app.
+ * The rotation is metadata: the encoder pipeline applies it (it does for the screen turn too).
+ */
+final class RotatingCapturerObserver implements CapturerObserver {
+    private final CapturerObserver inner;
+    private final AbstractVideoCaptureController controller;
+
+    RotatingCapturerObserver(CapturerObserver inner, AbstractVideoCaptureController controller) {
+        this.inner = inner;
+        this.controller = controller;
+    }
+
+    @Override
+    public void onCapturerStarted(boolean success) {
+        inner.onCapturerStarted(success);
+    }
+
+    @Override
+    public void onCapturerStopped() {
+        inner.onCapturerStopped();
+    }
+
+    @Override
+    public void onFrameCaptured(VideoFrame frame) {
+        int extra = controller.getExtraRotation();
+        if (extra == 0) {
+            inner.onFrameCaptured(frame);
+            return;
+        }
+        // Same buffer (the caller releases it after this returns), new rotation.
+        inner.onFrameCaptured(new VideoFrame(frame.getBuffer(), (frame.getRotation() + extra) % 360, frame.getTimestampNs()));
+    }
+}
