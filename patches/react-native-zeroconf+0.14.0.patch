@@ -224,6 +224,13 @@ public class NsdServiceImpl implements Zeroconf {
 
             WritableArray addresses = new WritableNativeArray();
             addresses.pushString(host.getHostAddress());
+            // Android 14+ resolves every address the service publishes (a host with Wi-Fi, VPN and
+            // virtual adapters has several); getHost() is only the first. Pass them all on.
