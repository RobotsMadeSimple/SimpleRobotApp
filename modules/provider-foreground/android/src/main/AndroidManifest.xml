<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Foreground service so streaming survives backgrounding / screen-off. On Android 14+ the
       matching typed permission is mandatory for each service type we use. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <!-- connectedDevice: sensors-only streaming (no daily time limit, unlike dataSync on Android 15+).
       It needs one of a few "talks to a device" permissions as well; CHANGE_NETWORK_STATE is a normal
       (install-time) one. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.providerforeground.ProviderForegroundService"
      android:exported="false"
      android:foregroundServiceType="camera|dataSync|location|connectedDevice" />
  </application>

</manifest>
