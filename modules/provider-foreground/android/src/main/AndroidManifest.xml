<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- Foreground service so streaming survives backgrounding / screen-off. On Android 14+ the
       matching typed permission is mandatory for each service type we use. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.providerforeground.ProviderForegroundService"
      android:exported="false"
      android:foregroundServiceType="camera|dataSync|location" />
  </application>

</manifest>
