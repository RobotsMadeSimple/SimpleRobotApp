{
  "name": "simple-robot-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "electron": "npx expo export --platform web && electron electron.js",
    "electron:build": "npx expo export --platform web && npx esbuild electron.js --bundle --platform=node --outfile=electron-bundle.js --external:electron && electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.robotsmadesimple.app",
    "productName": "Simple Robot App",
    "extraMetadata": {
      "main": "electron-bundle.js"
    },
    "asar": false,
    "files": [
      "dist/**",
      "electron-bundle.js",
      "preload.js",
      "!node_modules/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/images/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "@expo/html-elements": "^0.10.1",
    "@expo/react-native-action-sheet": "^4.1.1",
    "@expo/vector-icons": "^15.0.3",
    "@gluestack-ui/core": "^3.0.10",
    "@gluestack-ui/utils": "^3.0.11",
    "@legendapp/motion": "^2.3.0",
    "@lucide/lab": "^0.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "bonjour-service": "^1.3.0",
    "clipper-lib": "^6.4.2",
    "dxf-parser": "^1.1.2",
    "expo": "^57",
    "expo-build-properties": "~57.0.17",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-screen-orientation": "~57.0.2",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "lucide-react": "^0.563.0",
    "lucide-react-native": "^0.563.0",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-aria": "^3.33.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "react-native-zeroconf": "^0.14.0",
    "react-stately": "^3.39.0",
    "tailwind-variants": "^0.1.20"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "babel-plugin-module-resolver": "^5.0.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "private": true
}
